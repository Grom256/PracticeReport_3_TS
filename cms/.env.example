# Connection string Neon PostgreSQL (or a local PostgreSQL instance)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/grombricks_db

# Use a unique value of at least 32 characters in production
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Public CMS URL after deployment
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
